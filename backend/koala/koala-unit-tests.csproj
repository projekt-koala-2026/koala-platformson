<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <BaseIntermediateOutputPath>obj/tests/</BaseIntermediateOutputPath>
        <BaseOutputPath>bin/tests/</BaseOutputPath>
        <!-- TURNED OFF ANOYING WARRNINGS FOR NOW -->
  	    <NoWarn>$(NoWarn);CS8618;CS8602</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="**/*" />
        <Compile Include="src/**/Tests/*.cs" />
        <Compile Include="src/**/Tests/UnitTests/**/*.cs" />
    </ItemGroup>

	<ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="Moq" Version="4.21.0" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
	</ItemGroup>

    <ItemGroup>
        <ProjectReference Include="koala.csproj" />
    </ItemGroup>

</Project>
