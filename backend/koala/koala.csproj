<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<!-- TURNED OFF ANOYING WARRNINGS FOR NOW -->
  	<NoWarn>$(NoWarn);CS8618;CS8602</NoWarn>

	<InterceptorsNamespaces>
		$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated
	</InterceptorsNamespaces>
	<!-- Keep nested test outputs out of the web project's content globs. -->
	<DefaultItemExcludes>$(DefaultItemExcludes);src/Modules/Account/Tests/**</DefaultItemExcludes>
  </PropertyGroup>

	<ItemGroup>
		<Compile Remove="src/**/Tests/**/*.cs" />
    </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
		<PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="MicroElements.AspNetCore.OpenApi.FluentValidation" Version="7.2.4" />
		<PackageReference Include="MicroElements.Swashbuckle.FluentValidation" Version="7.2.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
		<PackageReference Include="Scalar.AspNetCore" Version="2.10.3" />
		<PackageReference Include="StackExchange.Redis" Version="3.1.13" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.11" />
		<PackageReference Include="CsvHelper" Version="33.0.1" />
		<PackageReference Include="FluentValidation" Version="12.2.0" />
    	<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    	<PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
	</ItemGroup>

</Project>
