# Redis container
REDIS_PORT=6379
REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_PASSWORD=password

# PostgreSQL container
POSTGRES_DB=db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# ASP.NET backend container
BACKEND_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
DOTNET_GCHeapHardLimit=367001600

# Configuration consumed by the backend process
ConnectionStrings__Local_Database_Postgres=Host=koala_postgres_container;Port=5432;Database=db;Username=user;Password=password
ConnectionStrings__Local_Cache_Redis=koala_redis_container:6379,password=password,abortConnect=false
FileSettings__PublicFilesPath=/app/backend_data/public_files
FileSettings__PrivateFilesPath=/app/backend_data/private_files
FrontendUrl=http://localhost:5173
EmailSettings__SmtpHost=koala_test_mailpit_container
EmailSettings__SmtpPort=1025
EmailSettings__SenderEmail=noreply@project.local
